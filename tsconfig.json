{
    "compilerOptions": {
        "target": "es6",
        "module": "esnext",
        "rootDir": "./src",
        "outDir": "./dist",
        "strict": true,
        "sourceMap": true,
        "esModuleInterop": true,
        "moduleResolution": "node",
        "lib": ["DOM", "ES6"],
        "skipLibCheck": true
    },
    "include": ["src"]
}
